#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# hub-stats [groupBy ...] [-- filter=value ...]
#
# Aggregate resource counts from the resourcestats endpoint. This is the only
# correct way to count: metadata.total saturates at 1000, so a paged count is a
# lower bound.
#
#   hub-stats                                  # fleet totals
#   hub-stats kind                             # by kind
#   hub-stats controlPlane kind                # by control plane, then kind
#   hub-stats kind -- ready=False              # only resources that aren't Ready
#   hub-stats -- controlPlanes=prod-1,prod-2   # totals for two control planes
#
# groupBy dimensions: kind, group, controlPlane, realm, space, ready, synced,
# healthy, crossplaneType. Anything else is rejected here rather than silently
# becoming a bogus dimension.
#
# Stats filters are their own set, and are NOT the /resources filter fields:
# kinds, groups, controlPlanes, realms, spaces (comma-separated lists) and
# ready, synced, healthy (single values). Unknown keys are dropped by the
# server without an error, so they are rejected here too.
set -euo pipefail

dir="$(cd "$(dirname "$0")" && pwd)"

usage() { awk 'NR>2 && !/^#/{exit} NR>2{sub(/^# ?/, ""); print}' "$0"; }

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

VALID_DIMENSIONS="kind group controlPlane realm space ready synced healthy crossplaneType"
LIST_FILTERS="kinds groups controlPlanes realms spaces"
SCALAR_FILTERS="ready synced healthy"

group_by=()
filters=()
seen_separator=false
for arg in "$@"; do
  if [ "$arg" = "--" ]; then
    seen_separator=true
  elif [ "$seen_separator" = true ]; then
    filters+=("$arg")
  else
    group_by+=("$arg")
  fi
done

groups_json='[]'
if [ ${#group_by[@]} -gt 0 ]; then
  for dim in "${group_by[@]}"; do
    case " $VALID_DIMENSIONS " in
      *" $dim "*) ;;
      *) echo "hub-stats: '$dim' is not a groupBy dimension." >&2
         echo "  Valid: $VALID_DIMENSIONS" >&2
         echo "  (filters go after --, e.g. hub-stats kind -- ready=False)" >&2
         exit 2 ;;
    esac
  done
  groups_json="$(printf '%s\n' "${group_by[@]}" | jq -R . | jq -s .)"
fi

filters_json='{}'
if [ ${#filters[@]} -gt 0 ]; then
  for filter in "${filters[@]}"; do
    key="${filter%%=*}"
    value="${filter#*=}"
    if [ "$key" = "$filter" ]; then
      echo "hub-stats: filter '$filter' must be key=value" >&2
      exit 2
    fi
    if [[ " $SCALAR_FILTERS " == *" $key "* ]]; then
      filters_json="$(jq -c --arg k "$key" --arg v "$value" '.[$k] = $v' <<<"$filters_json")"
    elif [[ " $LIST_FILTERS " == *" $key "* ]]; then
      filters_json="$(jq -c --arg k "$key" --arg v "$value" \
        '.[$k] = ($v | split(","))' <<<"$filters_json")"
    else
      echo "hub-stats: '$key' is not a stats filter; the server would ignore it." >&2
      echo "  Lists: $LIST_FILTERS" >&2
      echo "  Single values: $SCALAR_FILTERS" >&2
      exit 2
    fi
  done
fi

# apiVersion and kind are required: the handler decodes with no GVK defaults and
# checks for an exact match, so a bare {"query": ...} is a 400.
status=0
response="$(jq -nc --argjson groupBy "$groups_json" --argjson filters "$filters_json" \
  '{apiVersion: "hub.upbound.io/v1beta1", kind: "ResourceStats",
    query: {filters: $filters, groupBy: $groupBy}}' \
| "$dir/hub-curl" /apis/hub.upbound.io/v1beta1/resourcestats \
    -X POST -H 'Content-Type: application/json' --data-binary @-)" || status=$?
if [ "$status" -ne 0 ]; then
  [ -n "$response" ] && printf '%s\n' "$response" >&2
  exit "$status"
fi

# The server drops filter keys it does not recognize and returns 200, so a
# filter this client accepts but the server ignores comes back as the whole
# fleet wearing the shape of a filtered answer. It does echo what it applied
# under .query.filters, which makes the drop detectable -- so compare, rather
# than trusting that the query ran as written.
#
# The check is against the server, not against this script's own list: the two
# can drift, and it is the drift that produces the wrong number.
dropped="$(jq -r --argjson sent "$filters_json" '
  ($sent | keys_unsorted) - ((.query.filters // {}) | keys_unsorted)
  | join(", ")' <<<"$response" 2>/dev/null || true)"
if [ -n "$dropped" ]; then
  echo "hub-stats: the server ignored these filters: $dropped" >&2
  echo "  The count below is NOT filtered by them. Check the spelling against" >&2
  echo "  references/querying.md, or the server's filter set has changed." >&2
fi

printf '%s\n' "$response"
